{
  "name": "Reusable - Lead Intake Score",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b=$json.body??$json; let score=0; if(b.phone)score+=20; if(b.email)score+=15; if(b.budget)score+=25; if(b.project)score+=20; if(String(b.message??'').length>40)score+=20; const grade=score>=75?'HOT':score>=45?'WARM':'COLD'; const payload={...b,score,grade}; return [{json:{event_type:'lead_intake',status:grade.toLowerCase(),payload,text:'🎯 Lead '+grade+' ('+score+'/100)\\n'+(b.name??'بدون اسم')+'\\n'+(b.project??b.message??'')}}];"
      },
      "id": "score",
      "name": "Score Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/functions/v1/automation-event",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-key",
              "value": "={{$env.AUTOMATION_WEBHOOK_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({event_type:$json.event_type,status:$json.status,payload:$json.payload}) }}",
        "options": {}
      },
      "id": "log",
      "name": "Log Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ {chat_id:$env.TELEGRAM_CHAT_ID,text:$('Score Lead').item.json.text} }}",
        "options": {}
      },
      "id": "telegram",
      "name": "Notify Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        100
      ]
    }
  ],
  "connections": {
    "Lead Webhook": {
      "main": [
        [
          {
            "node": "Score Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Score Lead": {
      "main": [
        [
          {
            "node": "Log Lead",
            "type": "main",
            "index": 0
          },
          {
            "node": "Notify Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}