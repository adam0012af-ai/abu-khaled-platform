{
  "name": "Abu Khaled - Telegram Admin Add",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "abu-khaled-telegram-admin",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "tgwebhook",
      "name": "Telegram Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const u=$json.body??$json; const text=u.message?.text??''; const chat=u.message?.chat?.id; const m=text.match(/^\\/add\\s+(https?:\\/\\/\\S+)/i); if(!m) return [{json:{chat,text:'الاستخدام: /add رابط_المنتج',valid:false}}]; return [{json:{chat,url:m[1],valid:true}}];"
      },
      "id": "parse",
      "name": "Parse Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.valid}}",
              "operation": "isTrue"
            }
          ]
        },
        "options": {}
      },
      "id": "if",
      "name": "Valid Add Command",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/functions/v1/offer-import",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-key",
              "value": "={{$env.AUTOMATION_WEBHOOK_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({url:$json.url,provider:'telegram'}) }}",
        "options": {}
      },
      "id": "import",
      "name": "Import From Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ {chat_id:$('Parse Command').item.json.chat,text:$json.ok ? 'تمت إضافة/تحديث العرض: '+$json.offer_id : 'تعذر إضافة العرض'} }}",
        "options": {}
      },
      "id": "replyok",
      "name": "Reply Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ {chat_id:$json.chat,text:$json.text} }}",
        "options": {}
      },
      "id": "replyhelp",
      "name": "Reply Help",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        100
      ]
    }
  ],
  "connections": {
    "Telegram Webhook": {
      "main": [
        [
          {
            "node": "Parse Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Command": {
      "main": [
        [
          {
            "node": "Valid Add Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid Add Command": {
      "main": [
        [
          {
            "node": "Import From Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reply Help",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Import From Telegram": {
      "main": [
        [
          {
            "node": "Reply Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}